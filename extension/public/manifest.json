{
  "name": "VocabBoost",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Vocabulary learning extension powered by AI. Look up a word from the subtitles without leaving the video.",
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.netflix.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "lookup-subtitle": {
      "suggested_key": {
        "default": "Ctrl+H",
        "mac": "Command+H"
      },
      "description": "Look up a word from the current subtitle line"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.netflix.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  }
}
